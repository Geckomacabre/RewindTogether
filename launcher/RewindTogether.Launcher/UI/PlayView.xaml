<UserControl x:Class="RewindTogether.Launcher.UI.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================ setup: one line, at most one button -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="SETUP" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <!-- The launcher installs UE4SS and the mod by itself; this button is only there when
                         something needs the player (close the game, find it, or a first click). -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource PinkButton}" Content="{Binding SetupButton}" Command="{Binding SetupCommand}"
                            Padding="18,8" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0"
                            Visibility="{Binding SetupButton, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding SetupButton}" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Body}" Text="{Binding SetupIcon}" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                               Foreground="{Binding SetupTone, Converter={StaticResource Tone}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding SetupText}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Dim}" Text="{Binding SetupDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding SetupDetail, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>
                <Border Margin="0,10,0,0" CornerRadius="9" Padding="12,7" Background="#22FFD319" Visibility="{Binding BuildWarning, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Body}" Text="{Binding BuildWarning}" Foreground="{StaticResource YellowBrush}" FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ================================================================ host / join cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDE A: HOST -->
            <Border Style="{StaticResource Card}" BorderBrush="#88FF3EA5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SIDE A" Style="{StaticResource Eyebrow}" Foreground="{StaticResource PinkBrush}" />
                        <TextBlock Text="HOST YOUR STORE" Style="{StaticResource H1}" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Dim}" LineHeight="20"
                                   Text="Open your video store to your Steam friends. Nobody types an IP address or opens a port." />

                        <Button Style="{StaticResource BigPinkButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch" Command="{Binding HostCommand}"
                                Visibility="{Binding IsHosting, Converter={StaticResource NotVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="16" Height="16" Fill="White" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Text="HOST MY STORE" />
                            </StackPanel>
                        </Button>

                        <!-- which save to host (optional; default = choose in the game) -->
                        <DockPanel Margin="0,14,0,0" Visibility="{Binding IsHosting, Converter={StaticResource NotVis}}">
                            <TextBlock DockPanel.Dock="Left" Text="SAVE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="2,0,12,0" />
                            <ComboBox ItemsSource="{Binding SaveSlotOptions}" SelectedItem="{Binding SelectedSaveSlot, Mode=TwoWay}" DropDownOpened="OnSaveSlotsOpening"
                                      AutomationProperties.Name="Save to host"
                                      ToolTip="Pick a save and the game loads it straight from the main menu, then opens it to friends. Leave it on &quot;Choose my save in the game&quot; to pick it yourself.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <!-- how it works (before hosting) -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsHosting, Converter={StaticResource NotVis}}">
                            <StackPanel.Resources>
                                <Style x:Key="Step" TargetType="Border">
                                    <Setter Property="Width" Value="24" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="Background" Value="#33FF3EA5" />
                                    <Setter Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Margin" Value="0,0,12,0" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </Style>
                                <Style x:Key="StepNum" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{StaticResource PinkBrush}" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="HOW IT WORKS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,10">
                                <Border Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepNum}" /></Border>
                                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                                           Text="Press HOST - Retro Rewind starts through Steam." />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepNum}" /></Border>
                                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                                           Text="Load your save (or pick one above) and walk in." />
                            </DockPanel>
                            <DockPanel>
                                <Border Style="{StaticResource Step}"><TextBlock Text="3" Style="{StaticResource StepNum}" /></Border>
                                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                                           Text="Your store opens by itself - friends press JOIN on you." />
                            </DockPanel>
                        </StackPanel>

                        <!-- while hosting -->
                        <StackPanel Visibility="{Binding IsHosting, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                            <Border Style="{StaticResource Inset}" BorderBrush="{StaticResource PinkBrush}" BorderThickness="1.5">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="■  STOP" Command="{Binding StopCommand}" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="NOW HOSTING" Style="{StaticResource Eyebrow}" Foreground="{StaticResource PinkBrush}" />
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Phase}" Margin="0,3,10,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="GUESTS" Style="{StaticResource Eyebrow}" Margin="0,16,0,6" />
                            <TextBlock Style="{StaticResource Dim}" FontSize="13" Visibility="{Binding Guests.Count, Converter={StaticResource NotVis}}"
                                       Text="Nobody yet. Friends can press JOIN on you in their launcher, or right-click you in Steam and choose Join Game." />
                            <ItemsControl ItemsSource="{Binding Guests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Inset}" Margin="0,0,0,6" Padding="12,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Traffic}" Style="{StaticResource Mono}" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                                <Ellipse Width="9" Height="9" Fill="{Binding Tone, Converter={StaticResource Tone}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Link}" Foreground="{StaticResource TextDimBrush}" Margin="10,0" FontSize="12.5" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,14,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="Load friends" Command="{Binding RefreshFriendsCommand}" />
                                <TextBlock Text="INVITE A FRIEND" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding InvitableFriends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="Invite"
                                                    Command="{Binding InviteCommand}" CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StateText}" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="10,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0" Visibility="{Binding MySteamId, Converter={StaticResource Vis}}">
                                <Run Text="Your Steam ID (for friends using Join by Steam ID):" />
                                <Run Text="{Binding MySteamId, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource CyanBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- SIDE B: JOIN -->
            <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="#882DE2E6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SIDE B" Style="{StaticResource Eyebrow}" Foreground="{StaticResource CyanBrush}" />
                        <TextBlock Text="VISIT A FRIEND" Style="{StaticResource H1}" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Dim}" LineHeight="20"
                                   Text="See which Steam friends have their store open and walk right in. The game starts and connects by itself - straight from the main menu, no save needed." />

                        <!-- while joining -->
                        <Border Style="{StaticResource Inset}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5" Margin="0,16,0,0"
                                Visibility="{Binding IsJoining, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="■  STOP" Command="{Binding StopCommand}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="JOINING" Style="{StaticResource Eyebrow}" Foreground="{StaticResource CyanBrush}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Phase}" Margin="0,3,10,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,18,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="⟳  Refresh" Command="{Binding RefreshFriendsCommand}" />
                            <TextBlock Text="FRIENDS WITH THEIR STORE OPEN" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Foreground="{StaticResource CyanGradient}"
                                     Visibility="{Binding FriendsLoading, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding HostingFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inset}" Margin="0,0,0,8" Padding="12,10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource CyanButton}" Content="JOIN  ▶" Command="{Binding JoinCommand}" CommandParameter="{Binding}"
                                                    FontSize="15" Padding="20,8" VerticalAlignment="Center" />
                                            <Grid Width="40" Height="40" Margin="0,0,12,0">
                                                <Ellipse Fill="{StaticResource PinkGradient}" />
                                                <TextBlock Text="{Binding Name, Converter={StaticResource FirstLetter}}" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource GreenBrush}" FontSize="12.5" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Dim}" FontSize="13" Text="{Binding FriendsStatus}" Margin="0,2,0,0" />

                        <!-- other ways -->
                        <Button Style="{StaticResource SmallGhostButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding ToggleOtherWaysCommand}"
                                Content="Other ways to join (IP address, Steam ID)  ▾" />
                        <StackPanel Visibility="{Binding OtherWaysOpen, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                            <TextBlock Text="JOIN BY ADDRESS - same house, LAN or VPN (e.g. Tailscale)" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CyanButton}" Content="JOIN" Command="{Binding JoinAddressCommand}" Margin="8,0,0,0" />
                                <TextBox AutomationProperties.Name="Friend's address" Text="{Binding JoinAddress, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 192.168.1.50 or 100.101.102.103:27015" />
                            </DockPanel>
                            <TextBlock Text="JOIN BY STEAM ID - over the internet, through Steam" Style="{StaticResource Eyebrow}" Margin="0,14,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CyanButton}" Content="JOIN" Command="{Binding JoinSteamIdCommand}" Margin="8,0,0,0" />
                                <TextBox AutomationProperties.Name="Friend's Steam ID" Text="{Binding JoinSteamIdText, UpdateSourceTrigger=PropertyChanged}" Tag="17-digit Steam ID, e.g. 76561198000000000" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================================================ VCR display -->
        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="16" Background="#0A0918" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" Background="#14122C" Padding="14,6" VerticalAlignment="Center" MinWidth="118">
                    <TextBlock Text="{Binding VcrMode}" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{Binding VcrTone, Converter={StaticResource Tone}}">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.9" Color="#FF3EA5" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VcrTitle}" FontFamily="{StaticResource MonoFont}" FontSize="17" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding VcrDetail}" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,2,0,0"
                               Visibility="{Binding VcrDetail, Converter={StaticResource Vis}}" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource RedBrush}" FontSize="12.5" Margin="0,2,0,0" Visibility="{Binding LastError, Converter={StaticResource Vis}}">
                        <Run Text="Mod says: " /><Run Text="{Binding LastError, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LinkText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TrafficText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ModVersionText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
