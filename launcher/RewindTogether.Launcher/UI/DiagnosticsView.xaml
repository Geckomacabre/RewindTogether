<UserControl x:Class="RewindTogether.Launcher.UI.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================ left: system check + settings -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="⟳  Check again" Command="{Binding RefreshCommand}" />
                            <TextBlock Text="SYSTEM CHECK" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Tone, Converter={StaticResource Tone}}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource TextFaintBrush}" FontSize="13" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Body}" Text="{Binding Value}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource H2}" Margin="0,0,0,12" />

                        <TextBlock Text="GAME FOLDER" Style="{StaticResource Eyebrow}" Margin="0,0,0,5" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="Find automatically" Command="{Binding AutoDetectCommand}" Margin="6,0,0,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="Browse..." Command="{Binding BrowseGameCommand}" Margin="8,0,0,0" />
                            <Border Style="{StaticResource Inset}" Padding="10,6">
                                <TextBlock Text="{Binding GameFolder}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameFolder}" />
                            </Border>
                        </DockPanel>

                        <CheckBox Style="{StaticResource Switch}" Margin="0,16,0,0" IsChecked="{Binding HostFriendsOnly}">
                            <TextBlock Style="{StaticResource Body}" Text="When hosting, only let in people on my Steam friends list" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,0" IsChecked="{Binding BackupBeforeInstall}">
                            <TextBlock Style="{StaticResource Body}" Text="Back up my saves before installing anything" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,0" IsChecked="{Binding CheckForUpdates}">
                            <TextBlock Style="{StaticResource Body}" Text="Tell me when a new version of Rewind Together is out" />
                        </CheckBox>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="Check now" Command="{Binding CheckForUpdatesCommand}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Dim}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,0" IsChecked="{Binding DiscordStatus}">
                            <TextBlock Style="{StaticResource Body}" Text="Show &quot;Playing Rewind Together&quot; on my Discord profile" />
                        </CheckBox>
                        <TextBlock Text="{Binding DiscordStatusText}" Style="{StaticResource Dim}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="MOD LIST ADDRESS (CATALOG URL) - leave empty for the built-in list" Style="{StaticResource Eyebrow}" Margin="0,16,0,5" />
                        <TextBox AutomationProperties.Name="Catalog URL" Text="{Binding CatalogUrl, UpdateSourceTrigger=PropertyChanged}" Tag="https://.../catalog.json" />
                        <TextBlock Text="GUEST TUNNEL PORT (advanced, default 27016)" Style="{StaticResource Eyebrow}" Margin="0,12,0,5" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource CyanButton}" Content="Save settings" Command="{Binding SaveSettingsCommand}" Margin="10,0,0,0" />
                            <TextBox AutomationProperties.Name="Guest tunnel port" Text="{Binding GuestPort, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ right: tools + logs -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TOOLS" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <Button Style="{StaticResource PinkButton}" Content="⧉  Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Stretch"
                            ToolTip="Versions, paths, the game build and the last 200 lines of each log, ready to paste into a bug report" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="2,6,0,12"
                               Text="Copies everything a helper needs: versions, paths, game build and the last 200 log lines. Paste it into your bug report." />
                    <UniformGrid Columns="2">
                        <UniformGrid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                        </UniformGrid.Resources>
                        <Button Content="Open game folder" Command="{Binding OpenGameFolderCommand}" />
                        <Button Content="Open Binaries\Win64" Command="{Binding OpenWin64Command}" />
                        <Button Content="RewindTogether.log" Command="{Binding OpenModLogCommand}" />
                        <Button Content="UE4SS.log" Command="{Binding OpenUe4ssLogCommand}" />
                        <Button Content="Launcher log" Command="{Binding OpenLauncherLogCommand}" />
                        <Button Content="Launcher data folder" Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="Back up saves now" Command="{Binding BackupNowCommand}" />
                        <Button Content="Open backups" Command="{Binding OpenBackupsCommand}" />
                    </UniformGrid>
                    <DockPanel Margin="0,10,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SmallGhostButton}" Content="Mod" Command="{Binding ShowLogCommand}" CommandParameter="RewindTogether.log" Margin="0,0,4,0" />
                            <Button Style="{StaticResource SmallGhostButton}" Content="UE4SS" Command="{Binding ShowLogCommand}" CommandParameter="UE4SS.log" Margin="0,0,4,0" />
                            <Button Style="{StaticResource SmallGhostButton}" Content="Launcher" Command="{Binding ShowLogCommand}" CommandParameter="launcher.log" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center">
                            <Run Text="LAST 200 LINES - " /><Run Text="{Binding LogName, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
                <TextBox Style="{StaticResource LogBox}" Text="{Binding LogText, Mode=OneWay}" MinHeight="120" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
